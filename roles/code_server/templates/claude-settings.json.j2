{
  "env": {
    "ANTHROPIC_BASE_URL": "{{ code_server_claude_api_base_url }}",
    "ANTHROPIC_API_KEY": "{{ code_server_claude_api_key }}",
    "ANTHROPIC_MODEL": "{{ code_server_claude_default_model }}",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(ansible-navigator:*)",
      "Bash(ansible-playbook:*)",
      "Bash(ansible-lint:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(cd:*)"
    ]
  }
}
